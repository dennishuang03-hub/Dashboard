# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets. Nothing here belongs in Git — the password hash and the session key
# live in Vercel's environment variables, and `vercel env pull` writes them into
# .env.local for local development.
.env
.env.*
!.env.example

# Excel's lock files. Copying a workbook into data/ while it is open in Excel
# leaves a ~$name.xlsx beside it; it is not a spreadsheet and must not be
# committed or picked up as one.
~$*

# Vercel
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
